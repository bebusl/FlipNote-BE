# =============================================================
# FlipNote 로컬 개발 환경 변수
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워넣으세요.
# cp .env.example .env
# =============================================================

# -----------------------------------------------
# [공통] MySQL 루트 비밀번호 (직접 정해도 됨)
# -----------------------------------------------
MYSQL_ROOT_PASSWORD=flipnote_local

# GHCR 이미지 네임스페이스 (기본값은 기존 공개 이미지 계정)
GHCR_NAMESPACE=dungbik

# -----------------------------------------------
# [필수] JWT 시크릿 키
# 아무 랜덤 문자열이나 넣어도 됨 (최소 32자 권장)
# 예: openssl rand -hex 32
# -----------------------------------------------
JWT_SECRET=여기에_32자_이상의_랜덤_문자열_입력

# -----------------------------------------------
# [필수 - 이메일 기능] Resend API 키
# 이메일 인증/발송 기능이 필요 없으면 아무 값이나 넣어도 됨
# 실제 이메일이 필요하면 https://resend.com 에서 발급
# -----------------------------------------------
RESEND_API_KEY=re_임시값_이메일기능_안쓰면_아무거나
# Resend 도메인 인증 후 실제 발신 주소로 교체 (로컬 기본값은 localhost)
RESEND_FROM_EMAIL=FlipNote <no-reply@localhost>

# -----------------------------------------------
# [선택] Google OAuth2 (소셜 로그인)
# 구글 로그인 기능을 테스트하지 않으면 비워도 됨
# -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------
# [선택] AWS S3 (이미지 업로드)
# 이미지 업로드 기능을 테스트하지 않으면 비워도 됨
# -----------------------------------------------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=flipnote-bucket
S3_BUCKET_REGION=ap-northeast-2

# -----------------------------------------------
# [선택] Firebase FCM (푸시 알림)
# 푸시 알림 기능을 테스트하지 않으면 아무 값이나 넣어도 됨
# 실제 사용하려면 Firebase 콘솔에서 서비스 계정 JSON 전체를 한 줄로 넣어야 함
# -----------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON={}
